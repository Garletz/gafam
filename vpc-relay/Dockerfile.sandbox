FROM alpine:3.21

RUN apk add --no-cache \
    bash \
    curl \
    wget \
    python3 \
    py3-pip \
    nodejs \
    npm \
    sqlite \
    jq \
    git \
    vim \
    less \
    file \
    procps \
    coreutils \
    findutils \
    grep \
    sed \
    gawk \
    tar \
    gzip \
    unzip \
    openssh-client-default \
    tmux

# websockets: required by sandbox_server.py itself (the only baked-in package).
# Everything else is installed ON DEMAND by agents into PERSISTENT dirs on the
# /sandbox/files volume — the image stays minimal, capabilities grow at runtime
# and survive container recreations.
RUN pip3 install --break-system-packages websockets

ENV PYTHONUSERBASE=/sandbox/files/.pylibs
ENV NPM_CONFIG_PREFIX=/sandbox/files/.npm-global
ENV PATH=/sandbox/files/.npm-global/bin:/sandbox/files/.pylibs/bin:$PATH

RUN mkdir -p /sandbox/files /sandbox/tmp /sandbox/downloads /sandbox/screenshots /sandbox/scripts
RUN adduser -D -h /sandbox sandbox && chown -R sandbox:sandbox /sandbox

COPY sandbox_server.py /sandbox_server.py
RUN chmod +x /sandbox_server.py

EXPOSE 6090 6091

USER sandbox
WORKDIR /sandbox

CMD ["python3", "/sandbox_server.py"]
