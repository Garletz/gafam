FROM golang:alpine AS go

FROM node:22-bookworm-slim

ARG OPENCODE_VERSION=1.19.5

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    gh \
    python3 \
    sqlite3 \
    jq \
    ripgrep \
    openssh-client \
    procps \
    unzip \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

COPY --from=go /usr/local/go /usr/local/go
ENV PATH=/usr/local/go/bin:/usr/local/bin:/root/.opencode/bin:$PATH

RUN npm install -g opencode-ai@${OPENCODE_VERSION} && opencode --version

COPY opencode_server.py /opencode_server.py
RUN chmod +x /opencode_server.py

ENV HOME=/root \
    XDG_CONFIG_HOME=/root/.config \
    OPENCODE_DISABLE_AUTOUPDATE=1 \
    GIT_TERMINAL_PROMPT=0

EXPOSE 6092

CMD ["python3", "/opencode_server.py"]
