{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gafam-manager",
  "version": "0.1.0",
  "identifier": "com.gafam.manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "gafam-manager",
        "width": 800,
        "height": 750
      },
      {
        "label": "tray_window",
        "title": "GAFAM Status",
        "url": "/tray",
        "width": 350,
        "height": 450,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/scrcpy-server.jar"
    ]
  }
}
